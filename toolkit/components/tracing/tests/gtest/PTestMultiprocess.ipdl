include "mozilla/tracing/IPCTypes.h";

using opentelemetry::context::Context from "opentelemetry/context/context.h";
using opentelemetry::trace::TraceId from "opentelemetry/trace/trace_id.h";

namespace mozilla {
namespace tracing {
namespace tests {

[ChildProc=any, ChildImpl=virtual, ParentImpl=virtual]
protocol PTestMultiprocess {
child:
    async WithTraceContext(Context context, TraceId traceId);
parent:
    async __delete__();
};

}  // namespace tests
}  // namespace tracing
}  // namespace mozilla
