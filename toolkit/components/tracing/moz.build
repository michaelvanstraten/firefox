DIRS += [
    "ipc",
    "/third_party/opentelemetry-cpp",
]

EXPORTS.mozilla.tracing += [
    "Init.h",
]

UNIFIED_SOURCES += ["Init.cpp"]

USE_LIBS += ["gkopentelemetry", "opentelemetry_exporter_ostream_span"]

TEST_DIRS += ["tests"]

FINAL_LIBRARY = "xul"
